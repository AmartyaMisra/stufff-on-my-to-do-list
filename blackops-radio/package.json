{
  "name": "blackops-radio-globe",
  "version": "1.0.0",
  "description": "3D Globe Radio Station Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "keywords": ["electron", "radio", "globe", "three.js"],
  "author": "BlackOps Radio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^24.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "node-fetch": "^3.3.0",
    "three": "^0.150.0"
  },
  "build": {
    "appId": "com.blackops.radioglobe",
    "productName": "BlackOps Radio Globe",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}